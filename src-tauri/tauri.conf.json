{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyTool",
  "version": "0.6.7",
  "identifier": "com.aliboder.easytool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EasyTool",
        "width": 960,
        "height": 640,
        "minWidth": 400,
        "minHeight": 300,
        "visible": false,
        "backgroundColor": "#0a0a0a",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": ["modules/**/*"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Aliboder/EasyTool/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4NjkyNEU3QzdBRDNGOEQKUldTTlA2M0g1eVJwbU84cjdSSHJpQTZTalAxMGtOV1dCMjF6Qk0yUEU3NUlzQ01acTlndjBacncK"
    }
  }
}
