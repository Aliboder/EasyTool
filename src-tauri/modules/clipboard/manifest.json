{
  "id": "clipboard",
  "name": "剪贴板",
  "icon": "clipboard",
  "description": "记录剪贴板文本/图片/文件，支持固定与快速粘贴",
  "enabled": true,
  "default_config": {
    "max_items": 500,
    "hotkey": "Ctrl+Shift+V",
    "follow_mouse": true,
    "record_text": true,
    "record_image": true,
    "record_files": true,
    "min_text_len": 0,
    "cell_size": 80,
    "text_lines": 2,
    "show_timestamps": true
  }
}